{
	"name": "cloudflare-worker-boilerplate",
	"version": "0.0.0",
	"private": true,
	"engines": {
		"bun": ">=1.0.0"
	},
	"scripts": {
		"dev": "vite --mode ssr",
		"build": "qwik build",
		"build.client": "vite build",
		"build.server": "vite build -c ./adapters/cloudflare-pages/vite.config.ts",
		"build:types": "tcm --camelCase --pattern '**/*.module.css' --silent src && tsc --noEmit",
		"preview": "qwik build preview && vite preview",
		"deploy:develop": "bun run build && wrangler deploy --env develop",
		"deploy:staging": "bun run build && wrangler deploy --env staging",
		"deploy:production": "bun run build && wrangler deploy --env production",
		"cf-typegen": "wrangler types",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check --write .",
		"verify": "bun run check && bun run build:types && bun run test -- --reporter=dot --coverage",
		"test": "NODE_OPTIONS='--max-old-space-size=8192' vitest run",
		"test:unit": "vitest run test/unit",
		"test:integration": "vitest run test/integration",
		"test:coverage": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:generate:sql": "prisma generate --sql",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:status": "prisma migrate status",
		"db:push": "prisma db push",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.48",
		"@prisma/client": "^6.19.2",
		"@prisma/extension-accelerate": "^3.0.1",
		"ai": "^6.0.137",
		"katagami": "^3.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.14",
		"@builder.io/qwik": "^1.19.1",
		"@builder.io/qwik-city": "^1.19.1",
		"@paralleldrive/cuid2": "^3.3.0",
		"@types/bun": "^1.3.9",
		"@vitest/coverage-istanbul": "^4.0.18",
		"ignore": "^7.0.5",
		"prisma": "^6.19.2",
		"prisma-markdown": "^4.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-typed-css-modules": "^0.5.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.0.18",
		"wrangler": "^4.68.1"
	}
}
